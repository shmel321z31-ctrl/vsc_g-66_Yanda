const account3 = new Account("GB29NWBK60161331926819", "Анна Сидорова", 2500);//-100 делаю снятие )))

// Создание массива из счетов
const accountsList = [account1, account2, account3];// — это метод переменной в кот. находятся массивы
//совершаем операции пополнения и снятия со счетов
accountsList[2].withdraw(100);
accountsList[0].deposit(100);

// Вывод информации о всех счетах в консоль
console.log("\n=== ИНФОРМАЦИЯ О ВСЕХ СЧЕТАХ ===\n");
