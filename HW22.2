//  и выполняет перевод между счетами вызывая методы deposit 
//  и Откажитесь соответственно.

console.log('++++++++++++++++');

// Функция перевода средств между двумя объектами счетов

 function transfer(fromAccount, toAccount, amount) {
  // 1. Проверяем корректность суммы
  if (amount <= 0) {
    console.log("Ошибка: Сумма перевода должна быть больше 0");
    return;
  }

  // 2. Проверяем достаточность средств на балансе отправителя
  if (fromAccount.balance < amount) {
    console.log(`[${fromAccount.owner}] Недостаточно средств для перевода ${amount}`);
    return;
  }

  // 3. Снимаем деньги со счета отправителя
  fromAccount.draw(amount);

  // 4. Зачисляем деньги на счет получателя
  toAccount.deposit(amount);

  console.log(` Успешный перевод ${amount} от [${fromAccount.owner}] к [${toAccount.owner}]`);
}

const account1 = new Account("DE89370400440532013000", "Иван Иванов", 1000);
const account3 = new Account("GB29NWBK60161331926819", "Анна Сидорова", 2500);

// Переводим 300 от Анны к Ивану
transfer(account3, account1, 300);

// Проверяем балансы после перевода
console.log(account1.getBalance()); // 1300
console.log(account3.getBalance()); // 2200

