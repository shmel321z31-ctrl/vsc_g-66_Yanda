
//a. Создай функцию-конструктор объектов Account(iban,owner, balance), которая возвращает объект с:

// Номер счета (IBAN)
// именем владельца (owner)
// балансом (balance)
// методами:
// deposit(amount) — пополнение счёта
// draw(amount) — снятие денег (если хватает баланса)
// getBalance() — вывод текущего баланса
// Создайте несколько объектов счетов. Создайте массив из счетов. Выведите информацию о всех счетах в консоль






//----------------------------------> a <-------------------

// Функция-конструктор Account
function Account(iban, owner, balance) {
  this.iban = iban;
  this.owner = owner;
  this.balance = balance;

  // Пополнение счёта
  this.deposit = function (amount) {
    if (amount > 0) {
      this.balance += amount;
      console.log(`[${this.owner}] Счёт пополнен на ${amount}. Текущий баланс: ${this.balance}`);
    } else {
      console.log(`[${this.owner}] Сумма пополнения должна быть больше 0`);
    }
  };

  // Снятие денег (если хватает баланса)
  this.withdraw = function (amount) {
    if (amount <= 0) {
      console.log(`[${this.owner}] Сумма снятия должна быть больше 0`);
    } else if (amount > this.balance) {
      console.log(`[${this.owner}] Ошибка: недостаточно средств. Запрошено: ${amount}, доступно: ${this.balance}`);
    } else {
      this.balance -= amount;
      console.log(`[${this.owner}] Снято ${amount}. Остаток на счёте: ${this.balance}`);
    }
  };

  // Вывод текущего баланса //важный момент
  this.getBalance = function () {
    return this.balance;
  };
}

// Создание нескольких объектов счетов
const account1 = new Account("DE89370400440532013000", "Кеша Питерский", 1000);//при помощи оператора new , мы вводим 
